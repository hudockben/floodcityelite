# ---------------------------------------------------------------------------
# Portal — environment configuration
# Copy this file to `.env.local` and fill in the values below.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Databases — one per organization
#
# Each organization on the portal is a tenant with its own Postgres database, so
# there is one connection string per organization below. The two must point at
# *different* databases: nothing is shared between tenants at the storage layer,
# and that is the only reason no query can return one organization's rows to
# another's screen. Pointing both at the same database would silently put both
# organizations back into one set of tables, so the app and `npm run db:setup`
# both refuse to start when they match.
# ---------------------------------------------------------------------------

# Flood City Elite (company code: fce).
# Neon console -> Project -> "Connect" -> copy the "Pooled connection" string.
# It looks like:
#   postgresql://<user>:<password>@<host>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Fennell Bros. (company code: fennell).
# A separate Neon *database* — not a second user or schema on the one above. A
# new database inside the same Neon project is enough (Neon console -> Project
# -> "Databases" -> New database); it has its own tables, which is what matters.
# Then run:  npm run db:setup -- --tenant fennell
FENNELL_DATABASE_URL=

# Secret used to sign the login session cookie (JWT).
# Generate a strong random value, e.g.:  openssl rand -base64 32
SESSION_SECRET=

# Optional — map hostnames to organizations, so each one can have its own
# domain. Comma-separated `code=hostname` pairs:
#   TENANT_HOSTS="fennell=portal.fennellbros.com,fce=portal.floodcityelite.com"
# A request arriving on a listed hostname resolves to that organization before
# any `?c=<code>` link or cookie is consulted. Leave it blank and hostnames fall
# back to matching an organization's code against the host's own labels
# (`fennell.example.com`, `fennell-portal.vercel.app`), which covers preview
# deployments without any setup.
TENANT_HOSTS=

# Optional — the admin account created by `npm run db:setup`.
# Leave SEED_ADMIN_PASSWORD blank to have a strong one generated and printed
# once, or set your own here. Never commit a real password to this file.
# These apply to whichever organization the run targets, so a second run
# (`-- --tenant fennell`) seeds that organization's own admin with them.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
